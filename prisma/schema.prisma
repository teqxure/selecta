// Selecta database schema.
// Foundational models only — kept intentionally minimal per phase-1 scope.
// Connection URLs live in `prisma.config.ts` / `.env` (Prisma 7 no longer
// reads `url`/`directUrl` from the datasource block).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  AGENT
  /// In-house delivery rider — distinct from AGENT, which is an unrelated
  /// seller-support-liaison assignment (see SellerProfile.agentId).
  RIDER
  ADMIN
  SUPER_ADMIN
}

enum SellerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

/// Mirrors SellerVerificationStatus exactly — riders go through the same
/// PENDING -> VERIFIED|REJECTED review lifecycle as sellers.
enum RiderVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum SellerProductType {
  MALE_CLOTHES
  FEMALE_CLOTHES
  CHILDREN_CLOTHES
  SHOES
  BAGS
  ACCESSORIES
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD
  REJECTED
  REMOVED
}

enum ConditionGrade {
  SELECTA_GOLD
  SELECTA_CLASSIC
  SELECTA_VALUE
}

enum ProductGender {
  MALE
  FEMALE
  UNISEX
  KIDS
}

enum ProductImageKind {
  FRONT
  BACK
  DETAIL
  DEFECT
  OTHER
}

enum ProductEventType {
  VIEW
  SAVE
  UNSAVE
  SHARE
  CONTACT_SELLER
  /// One row per product shown on a search results page — batched via
  /// `createMany` per search, not one query per product. Backs seller
  /// "search appearances" insight and admin search analytics. Deliberately
  /// NOT logged for homepage sections (would multiply write volume for
  /// every visit with no proportional analytical value).
  IMPRESSION
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
  /// Terminal — reached only via dispute resolution siding with the
  /// buyer. Distinct from CANCELLED (never fulfilled) since a refunded
  /// order was paid for and may have shipped; the money simply came back.
  REFUNDED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  FAILED
}

/// Per-seller payout ledger status — a superset of Payment's lifecycle
/// because escrow hold/release happens per seller, not per order (one
/// order can contain items from several sellers).
enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
}

/// PENDING/PICKED_UP/IN_TRANSIT/DELIVERED/FAILED are the original values —
/// still driven by `ORDER_STATUS_TO_DELIVERY_STATUS` in delivery.service.ts
/// and never removed. The rest were added for the rider-driven dispatch
/// flow, which transitions through the finer-grained timeline the buyer/
/// seller tracking panel displays.
enum DeliveryStatus {
  PENDING
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  ON_THE_WAY
  NEARBY
  DELIVERED
  COMPLETED
  FAILED
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
  BREAK
}

enum ProofMethod {
  PIN
  QR
  PHOTO
  SIGNATURE
  GPS
}

enum DeliveryMethod {
  MANUAL
  PARTNER
}

enum LocationPermissionStatus {
  NOT_ASKED
  GRANTED
  DENIED
}

/// What the buyer chose commercially at checkout — kept separate from
/// `DeliveryMethod`/`Delivery.courier` (the seller's post-purchase
/// operational record) rather than renaming that enum's existing values.
enum DeliveryFulfillmentType {
  STANDARD
  EXPRESS
  PICKUP
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

enum DisputeType {
  WRONG_ITEM
  DAMAGED_ITEM
  NOT_RECEIVED
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUND
  RESOLVED_RELEASE
  RESOLVED_PARTIAL
  CLOSED
}

enum IntegrationCategory {
  PAYMENT
  STORAGE
  EMAIL
  SMS
  AI
}

enum MarketplaceStatus {
  OPEN
  PAUSED
  CLOSED
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  SYSTEM
  PROMOTION
  MESSAGE
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  phone                 String?                  @unique
  passwordHash          String?                  @map("password_hash")
  /// Google's stable account identifier ("sub" claim) — set once a user
  /// signs in with Google, whether that creates a brand-new account or
  /// links to an existing email/password one. Never null for a
  /// Google-only account (which also has passwordHash: null).
  googleId              String?                  @unique @map("google_id")
  firstName             String                   @map("first_name")
  lastName              String                   @map("last_name")
  avatarUrl             String?                  @map("avatar_url")
  role                  Role                     @default(BUYER)
  status                UserStatus               @default(ACTIVE)
  /// Individually-granted permission strings — only meaningful when role
  /// is ADMIN. SUPER_ADMIN's authority is implicit (wildcard, never
  /// stored); SELLER/BUYER get a fixed role-wide set defined in code, not
  /// per-user grants. See lib/auth/permissions.ts.
  permissions           String[]                 @default([])
  /// Optional custom Permission Engine role — only meaningful when role is
  /// ADMIN, layered alongside the individually-granted `permissions[]`
  /// above (union of both). See lib/auth/permissions.ts.
  staffRoleId           String?                  @map("staff_role_id")
  city                  String?
  state                 String?
  /// Ambient "roughly where the buyer is right now" signal for homepage
  /// personalization — separate from the saved `Address` book. Only ever
  /// set on an explicit "Allow location" tap or manual refresh, never a
  /// background/continuous watch.
  latitude              Float?
  longitude             Float?
  locationPermission    LocationPermissionStatus @default(NOT_ASKED) @map("location_permission")
  locationUpdatedAt     DateTime?                @map("location_updated_at")
  preferences           Json?
  emailVerifiedAt       DateTime?                @map("email_verified_at")
  /// Set by Super Admin to block sending new messages (not a full account
  /// suspension) — see Phase 11's "restrict messaging" admin action.
  /// Checked in conversation.service.ts before every send.
  messagingRestrictedAt DateTime?                @map("messaging_restricted_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  sellerProfile   SellerProfile?
  wallet          Wallet?
  orders          Order[]
  reviews         Review[]
  notifications   Notification[]
  deliveries      Delivery[]      @relation("AgentDeliveries")
  auditLogs       AuditLog[]
  addresses       Address[]
  activities      UserActivity[]
  loginHistory    LoginHistory[]
  sessions        Session[]
  assignedSellers SellerProfile[] @relation("SellerAgent")
  savedProducts   SavedProduct[]
  productEvents   ProductEvent[]
  cartItems       CartItem[]
  storeFollows    StoreFollow[]
  conversations   Conversation[]  @relation("BuyerConversations")
  messages        Message[]
  searchQueries   SearchQuery[]

  transactionsAsBuyer        Transaction[]              @relation("BuyerTransactions")
  orderStatusChanges         OrderStatusHistory[]
  withdrawalReviews          Withdrawal[]               @relation("WithdrawalReviewer")
  disputesAsBuyer            Dispute[]                  @relation("BuyerDisputes")
  disputesResolved           Dispute[]                  @relation("ResolvedDisputes")
  systemSettingsUpdated      SystemSettings[]
  integrationSettingsSet     IntegrationSetting[]
  commissionRulesCreated     CommissionRule[]
  featureFlagsUpdated        FeatureFlag[]
  aiConversations            AiConversation[]
  aiAssistantSettingsUpdated AiAssistantSettings[]
  ledgerEntries              LedgerEntry[]
  ledgerEntriesRecorded      LedgerEntry[]              @relation("LedgerEntryActor")
  emailTemplatesUpdated      EmailTemplate[]
  notificationDeliveries     NotificationDelivery[]
  subscriptionPlansCreated   SubscriptionPlan[]
  growthPartnerApplications  GrowthPartnerApplication[]
  offersAsBuyer              Offer[]                    @relation("BuyerOffers")
  messageFlags               MessageFlag[]
  deliveryZonesUpdated       DeliveryZone[]
  cityDeliveryPricingUpdated CityDeliveryPricing[]
  logisticsPartnersUpdated   LogisticsPartner[]
  deliveryRulesUpdated       DeliveryRule[]
  deliveryHolidaysCreated    DeliveryHoliday[]

  staffRole                      StaffRole?               @relation("StaffAssignment", fields: [staffRoleId], references: [id], onDelete: SetNull)
  staffRolesCreated              StaffRole[]              @relation("StaffRoleCreatedBy")
  riderProfile                   RiderProfile?
  complianceDocumentTypesCreated ComplianceDocumentType[]
  sellerDocumentsReviewed        SellerDocument[]
  couponsCreated                 Coupon[]
  couponRedemptions              CouponRedemption[]
  collectionsCreated             Collection[]
  campaignsCreated               MarketingCampaign[]
  returnsAsBuyer                 ReturnRequest[]          @relation("BuyerReturns")
  returnsResolved                ReturnRequest[]          @relation("ResolvedReturns")
  supportTickets                 SupportTicket[]          @relation("SupportTicketsAsUser")
  supportTicketsAssigned         SupportTicket[]          @relation("SupportTicketsAssigned")
  supportTicketMessages          SupportTicketMessage[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model SellerProfile {
  id                    String                   @id @default(cuid())
  userId                String                   @unique @map("user_id")
  businessName          String                   @map("business_name")
  storeName             String?                  @map("store_name")
  storeSlug             String?                  @unique @map("store_slug")
  logoUrl               String?                  @map("logo_url")
  bannerUrl             String?                  @map("banner_url")
  bio                   String?
  /// Free-form { instagram?, tiktok?, facebook? } handles/URLs shown on the
  /// public storefront — distinct from the in-message contact-safety system,
  /// since a public "follow us" link isn't the off-platform-payment/DM
  /// leakage that system guards against.
  socialLinks           Json?                    @map("social_links")
  marketLocation        String?                  @map("market_location")
  city                  String?
  state                 String?
  country               String                   @default("Nigeria")
  area                  String?
  latitude              Float?
  longitude             Float?
  locationUpdatedAt     DateTime?                @map("location_updated_at")
  /// Whether this seller offers in-person pickup at all — most do (every
  /// seller registers a physical market/shop), but a seller can opt out.
  /// Actual pickup *eligibility* for a given buyer is a computed distance
  /// check (see delivery-engine.service.ts), not a separate table.
  offersPickup          Boolean                  @default(true) @map("offers_pickup")
  categoryTags          SellerProductType[]      @map("category_tags")
  /// Set once, the first time a seller accepts the Seller Agreement during
  /// onboarding (see app/(buyer)/seller-agreement). Never cleared or
  /// re-prompted — a version bump to the agreement itself would need its
  /// own re-acceptance mechanism, not implemented yet.
  agreementAcceptedAt   DateTime?                @map("agreement_accepted_at")
  verificationStatus    SellerVerificationStatus @default(PENDING) @map("verification_status")
  ratingAverage         Float                    @default(0) @map("rating_average")
  ratingCount           Int                      @default(0) @map("rating_count")
  totalSales            Int                      @default(0) @map("total_sales")
  followerCount         Int                      @default(0) @map("follower_count")
  profileViewCount      Int                      @default(0) @map("profile_view_count")
  onboardingStep        Int                      @default(1) @map("onboarding_step")
  onboardingCompletedAt DateTime?                @map("onboarding_completed_at")
  agentId               String?                  @map("agent_id")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent                    User?                      @relation("SellerAgent", fields: [agentId], references: [id], onDelete: SetNull)
  products                 Product[]
  verification             SellerVerification?
  followers                StoreFollow[]
  conversations            Conversation[]
  transactions             Transaction[]
  withdrawals              Withdrawal[]
  disputes                 Dispute[]
  ledgerEntries            LedgerEntry[]
  subscriptions            SellerSubscription[]
  boostCampaigns           BoostCampaign[]
  monetizationPayments     MonetizationPayment[]
  growthPartnerApplication GrowthPartnerApplication[]
  offers                   Offer[]
  aiFeatureUsages          AiFeatureUsage[]
  documents                SellerDocument[]
  returnRequests           ReturnRequest[]

  @@index([verificationStatus])
  @@index([agentId])
  @@map("seller_profiles")
}

/// A buyer following a store — also doubles as "save store" (section 4),
/// same one-tap-interaction pattern as SavedProduct in the catalog phase.
model StoreFollow {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  sellerProfileId String   @map("seller_profile_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerProfileId])
  @@index([sellerProfileId])
  @@map("store_follows")
}

/// Seller onboarding step 3 submission: documents + admin review trail.
/// `SellerProfile.verificationStatus` is a denormalized copy of `status`
/// here, kept in sync by the seller-verification service, so RBAC/UI checks
/// never need to join into this table.
model SellerVerification {
  id                  String                   @id @default(cuid())
  sellerProfileId     String                   @unique @map("seller_profile_id")
  businessPhotoUrl    String?                  @map("business_photo_url")
  shopPhotoUrl        String?                  @map("shop_photo_url")
  identityDocumentUrl String?                  @map("identity_document_url")
  status              SellerVerificationStatus @default(PENDING)
  reviewedById        String?                  @map("reviewed_by_id")
  reviewNotes         String?                  @map("review_notes")
  submittedAt         DateTime                 @default(now()) @map("submitted_at")
  reviewedAt          DateTime?                @map("reviewed_at")

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("seller_verifications")
}

enum DocumentRequirement {
  REQUIRED
  OPTIONAL
  CONDITIONAL
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Super Admin-configurable document catalog — deliberately NOT a fixed set
/// of document types (unlike the 3-field `SellerVerification` above, which
/// stays as the onboarding bootstrap step). `category` is a free string
/// (e.g. "Individual", "Business") so different seller types can require
/// different documents without a schema change.
model ComplianceDocumentType {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  description   String?
  category      String?
  requirement   DocumentRequirement @default(REQUIRED)
  conditionNote String?             @map("condition_note")
  isActive      Boolean             @default(true) @map("is_active")
  sortOrder     Int                 @default(0) @map("sort_order")
  createdById   String?             @map("created_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  documents SellerDocument[]

  @@index([isActive])
  @@map("compliance_document_types")
}

/// A seller's uploaded instance of a `ComplianceDocumentType`. Re-upload is
/// just a new row for the same (sellerProfileId, documentTypeId) pair —
/// review/approval history is read back from `AuditLog` (entityType
/// "SellerDocument"), not duplicated into a history table here.
model SellerDocument {
  id              String               @id @default(cuid())
  sellerProfileId String               @map("seller_profile_id")
  documentTypeId  String               @map("document_type_id")
  fileUrl         String               @map("file_url")
  status          DocumentReviewStatus @default(PENDING)
  reviewedById    String?              @map("reviewed_by_id")
  reviewedAt      DateTime?            @map("reviewed_at")
  reviewNotes     String?              @map("review_notes")
  rejectionReason String?              @map("rejection_reason")
  submittedAt     DateTime             @default(now()) @map("submitted_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  sellerProfile SellerProfile          @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  documentType  ComplianceDocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  reviewedBy    User?                  @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([sellerProfileId])
  @@index([documentTypeId])
  @@index([status])
  @@map("seller_documents")
}

model Address {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  label             String?
  line1             String
  line2             String?
  city              String
  state             String
  country           String    @default("Nigeria")
  /// Area/district — a finer grain than city, coarser than a street
  /// address (e.g. "Gwarinpa" within Abuja).
  area              String?
  landmark          String?
  notes             String?
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime? @map("location_updated_at")
  phone             String?
  isDefault         Boolean   @default(false) @map("is_default")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// Lightweight behavioral event stream (logins, views, profile edits).
/// Distinct from `AuditLog`, which is the admin-facing security/audit trail
/// keyed by entity rather than by user.
model UserActivity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_activities")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  success   Boolean
  reason    String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_history")
}

/// One row per issued session JWT — this is what makes "view active
/// sessions" / "terminate this session" / "force logout everywhere"
/// possible at all, since the JWT itself is a stateless bearer token that
/// can't otherwise be revoked before its natural expiry. The JWT carries
/// this row's id as its `sid` claim; `currentUser()` checks `revokedAt` on
/// every request. `expiresAt` reflects the value at issuance only — the
/// sliding-refresh in proxy.ts re-signs the JWT with a later `exp` without
/// touching this row (proxy is deliberately DB-free), so treat `expiresAt`
/// as informational and `revokedAt` as the sole authority on validity.
/// Sessions created before this model existed have no matching row at all
/// — `currentUser()` treats a JWT with no `sid` claim as unrevocable
/// (pre-existing behavior), so already-logged-in users aren't force-logged-out
/// by this migration; they age out naturally within their existing expiry.
model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageUrl  String?  @map("image_url")
  parentId  String?  @map("parent_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryHierarchy")
  products        Product[]        @relation("ProductCategory")
  subcategoryOf   Product[]        @relation("ProductSubcategory")
  commissionRules CommissionRule[]
  coupons         Coupon[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String         @id @default(cuid())
  sellerId        String         @map("seller_id")
  categoryId      String         @map("category_id")
  subcategoryId   String?        @map("subcategory_id")
  title           String
  description     String?
  brand           String?
  color           String?
  gender          ProductGender?
  size            String?
  price           Decimal        @db.Decimal(10, 2)
  discountPrice   Decimal?       @map("discount_price") @db.Decimal(10, 2)
  estimatedValue  Decimal?       @map("estimated_value") @db.Decimal(10, 2)
  currency        String         @default("NGN")
  quantity        Int            @default(1)
  conditionGrade  ConditionGrade @default(SELECTA_CLASSIC) @map("condition_grade")
  status          ProductStatus  @default(DRAFT)
  material        String?
  videoUrl        String?        @map("video_url")
  city            String?
  state           String?
  market          String?
  pickupLocation  String?        @map("pickup_location")
  /// Denormalized copy of the seller's coordinates at listing time —
  /// consistent with `city`/`state`/`market`/`pickupLocation` above, which
  /// already denormalize from `SellerProfile`. Avoids a join on every
  /// search/homepage distance calculation; refreshed whenever the seller
  /// updates their location.
  latitude        Float?
  longitude       Float?
  viewCount       Int            @default(0) @map("view_count")
  likeCount       Int            @default(0) @map("like_count")
  shareCount      Int            @default(0) @map("share_count")
  isFeatured      Boolean        @default(false) @map("is_featured")
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  seller         SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category            @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategory    Category?           @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  orderItems     OrderItem[]
  reviews        Review[]
  savedBy        SavedProduct[]
  events         ProductEvent[]
  cartItems      CartItem[]
  boostCampaigns BoostCampaign[]
  conversations  Conversation[]
  offers         Offer[]
  collections    CollectionProduct[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([city, state])
  @@index([isFeatured])
  @@index([brand])
  @@index([price])
  @@index([viewCount])
  @@index([likeCount])
  @@index([latitude, longitude])
  @@map("products")
}

model ProductImage {
  id            String           @id @default(cuid())
  productId     String           @map("product_id")
  url           String
  kind          ProductImageKind @default(OTHER)
  position      Int              @default(0)
  // Hooks for a future AI pipeline (background removal / enhancement /
  // auto quality scoring) — left null until that service exists.
  processedUrl  String?          @map("processed_url")
  qualityScore  Float?           @map("quality_score")
  aiProcessedAt DateTime?        @map("ai_processed_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// Doubles as "like" (section 6/1) and "save" (section 9) — a single tap
/// interaction in the UI, so one model rather than two near-duplicates.
model SavedProduct {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("saved_products")
}

/// Raw event stream backing the denormalized Product counters and future
/// recommendation/analytics work — counters stay fast to read, this stays
/// the source of truth for aggregation.
model ProductEvent {
  id        String           @id @default(cuid())
  productId String           @map("product_id")
  userId    String?          @map("user_id")
  type      ProductEventType
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, type, createdAt])
  @@index([userId])
  @@map("product_events")
}

/// One row per executed search — the source of truth for autocomplete
/// suggestions, "popular searches", "trending keywords", and admin search
/// analytics (top searches, zero-result searches). Logged from
/// `searchProducts` only when a keyword was actually typed (`q` present),
/// not on pure filter/category browsing.
model SearchQuery {
  id          String   @id @default(cuid())
  query       String
  userId      String?  @map("user_id")
  resultCount Int      @map("result_count")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
  @@index([resultCount])
  @@map("search_queries")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Marketing — coupons, curated collections, campaigns
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Buyer-facing discount code. Never applied client-side — checkoutAction
/// re-validates and re-prices server-side, the same never-trust-the-client
/// principle already used for delivery pricing.
model Coupon {
  id                   String       @id @default(cuid())
  code                 String       @unique
  description          String?
  discountType         DiscountType @map("discount_type")
  discountValue        Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount       Decimal?     @map("min_order_amount") @db.Decimal(10, 2)
  /// Caps the discount for PERCENTAGE coupons (irrelevant for FIXED_AMOUNT).
  maxDiscountAmount    Decimal?     @map("max_discount_amount") @db.Decimal(10, 2)
  usageLimit           Int?         @map("usage_limit")
  usageLimitPerUser    Int?         @map("usage_limit_per_user")
  usedCount            Int          @default(0) @map("used_count")
  startsAt             DateTime?    @map("starts_at")
  endsAt               DateTime?    @map("ends_at")
  isActive             Boolean      @default(true) @map("is_active")
  applicableCategoryId String?      @map("applicable_category_id")
  createdById          String?      @map("created_by_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  applicableCategory Category?           @relation(fields: [applicableCategoryId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  orders             Order[]
  redemptions        CouponRedemption[]
  campaigns          MarketingCampaign[]

  @@index([isActive])
  @@map("coupons")
}

/// One row per successful redemption — the source of truth for
/// usageLimit/usageLimitPerUser enforcement (counted live, `Coupon.usedCount`
/// is a fast denormalized counter kept in sync alongside it).
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String   @map("coupon_id")
  userId         String   @map("user_id")
  orderId        String   @unique @map("order_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// Curated, admin-ordered product grouping — distinct from `Category`
/// (taxonomy) and from `BoostCampaign` (seller-paid single-product boost).
model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  products  CollectionProduct[]
  campaigns MarketingCampaign[]

  @@index([isActive])
  @@map("collections")
}

model CollectionProduct {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  productId    String   @map("product_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("collection_products")
}

/// A named marketing initiative wrapping an optional Collection and/or
/// Coupon with a date range — the thing an admin points a homepage banner
/// or notification blast at.
model MarketingCampaign {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  bannerImageUrl String?   @map("banner_image_url")
  collectionId   String?   @map("collection_id")
  couponId       String?   @map("coupon_id")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  coupon     Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("marketing_campaigns")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

model Order {
  id              String      @id @default(cuid())
  buyerId         String      @map("buyer_id")
  status          OrderStatus @default(CREATED)
  /// itemsSubtotal + deliveryFee — both auditable line items, never a
  /// single opaque number. deliveryFee defaults to 0 for pre-existing
  /// orders created before the delivery engine existed.
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  /// Coupon discount applied at checkout — itemsSubtotal + deliveryFee -
  /// discountAmount = totalAmount, all three auditable line items.
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  couponId        String?     @map("coupon_id")
  currency        String      @default("NGN")
  shippingAddress Json        @map("shipping_address")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  buyer            User                 @relation(fields: [buyerId], references: [id])
  items            OrderItem[]
  payment          Payment?
  delivery         Delivery?
  transactions     Transaction[]
  statusHistory    OrderStatusHistory[]
  disputes         Dispute[]
  ledgerEntries    LedgerEntry[]
  conversations    Conversation[]
  offer            Offer?
  coupon           Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

/// Every order status change is recorded here — the timeline shown to
/// buyer/seller/admin, and the audit trail for "who moved this order and
/// when." `actorId` is null for system/webhook-driven transitions.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  actorId   String?     @map("actor_id")
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  review        Review?
  returnRequest ReturnRequest?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// The buyer-facing capture: one Payment per Order, matching the single
/// charge the provider actually processes. Escrow hold/release happens
/// per seller below in `Transaction`, not here.
model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique @map("order_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("NGN")
  provider          String
  providerReference String?       @unique @map("provider_reference")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([status])
  @@map("payments")
}

/// The seller-facing payout ledger: one row per (order, seller) pair,
/// created once payment succeeds, carrying the commission split so a
/// seller's payout is never recomputed from scratch — it's the number
/// that was actually charged and committed at the time.
model Transaction {
  id               String            @id @default(cuid())
  orderId          String            @map("order_id")
  paymentId        String?           @map("payment_id")
  buyerId          String            @map("buyer_id")
  sellerId         String            @map("seller_id")
  amount           Decimal           @db.Decimal(10, 2)
  commissionRate   Float             @map("commission_rate")
  commissionAmount Decimal           @map("commission_amount") @db.Decimal(10, 2)
  sellerAmount     Decimal           @map("seller_amount") @db.Decimal(10, 2)
  currency         String            @default("NGN")
  provider         String
  reference        String?           @unique
  status           TransactionStatus @default(PENDING)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  buyer   User          @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller  SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status])
  @@index([orderId])
  @@index([status])
  @@map("transactions")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  balance          Decimal  @default(0) @db.Decimal(10, 2)
  /// Lifetime earnings — never decreases, even once a future withdrawal
  /// phase starts deducting from `balance`. Distinct source of truth from
  /// `balance` on purpose.
  totalEarned      Decimal  @default(0) @map("total_earned") @db.Decimal(10, 2)
  /// Cumulative amount paid out via approved withdrawals.
  withdrawnBalance Decimal  @default(0) @map("withdrawn_balance") @db.Decimal(10, 2)
  currency         String   @default("NGN")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Withdrawal {
  id            String           @id @default(cuid())
  sellerId      String           @map("seller_id")
  amount        Decimal          @db.Decimal(10, 2)
  bankName      String           @map("bank_name")
  accountNumber String           @map("account_number")
  accountName   String           @map("account_name")
  status        WithdrawalStatus @default(REQUESTED)
  reviewedById  String?          @map("reviewed_by_id")
  reviewNotes   String?          @map("review_notes")
  requestedAt   DateTime         @default(now()) @map("requested_at")
  processedAt   DateTime?        @map("processed_at")

  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([sellerId, status])
  @@map("withdrawals")
}

/// Mirrors Withdrawal exactly, FK'd to RiderProfile instead of
/// SellerProfile — a parallel table rather than overloading Withdrawal's
/// sellerId, since Wallet (which both draw down from) is already
/// role-agnostic and the review workflow is identical either way.
model RiderWithdrawal {
  id             String           @id @default(cuid())
  riderProfileId String           @map("rider_profile_id")
  amount         Decimal          @db.Decimal(10, 2)
  bankName       String           @map("bank_name")
  accountNumber  String           @map("account_number")
  accountName    String           @map("account_name")
  status         WithdrawalStatus @default(REQUESTED)
  reviewedById   String?          @map("reviewed_by_id")
  reviewNotes    String?          @map("review_notes")
  requestedAt    DateTime         @default(now()) @map("requested_at")
  processedAt    DateTime?        @map("processed_at")

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)

  @@index([riderProfileId, status])
  @@map("rider_withdrawals")
}

/// Every type of money movement the platform ever records. Amounts are
/// signed from the perspective of the entity they credit/debit: positive
/// increases what's owed to that entity, negative decreases it. See
/// services/finance/ledger.service.ts for the exact convention used by
/// each type.
enum LedgerEntryType {
  CUSTOMER_PAYMENT
  COMMISSION_EARNED
  VENDOR_CREDIT
  WITHDRAWAL_REQUEST
  WITHDRAWAL_PAID
  REFUND
  ADJUSTMENT
  /// Platform revenue from a seller subscription payment — 100% platform
  /// revenue, no seller split (unlike COMMISSION_EARNED, which is a cut of
  /// a buyer's order).
  SUBSCRIPTION_REVENUE
  /// Platform revenue from a seller paying cash (not subscription credits)
  /// for a product boost campaign.
  BOOST_REVENUE
  /// The delivery-fee portion of a buyer's payment — positive, 100%
  /// platform/logistics revenue, never split into a seller's Transaction
  /// (that only ever covers merchandise commission).
  DELIVERY_FEE_REVENUE
  /// A rider's cut of a delivery fee, credited to their Wallet on confirmed
  /// delivery — see SystemSettings.riderPayoutPercentage. Recorded
  /// independently of DELIVERY_FEE_REVENUE (which books the full fee as
  /// platform revenue at payment time); reconciling the two into a true
  /// net-of-rider-pay revenue figure is a known follow-up, not done here.
  RIDER_PAYOUT_EARNED
}

/// Append-only financial journal — the authoritative source for every
/// historical revenue/payout figure (GMV, commission earned, completed
/// payouts, refunds). Nothing here is ever updated or deleted; a
/// correction is made by writing a new offsetting entry (typically
/// ADJUSTMENT), never by editing a prior row. Wallet/Transaction/
/// Withdrawal status columns remain the fast, mutable "current state" —
/// this table is the immutable "what actually happened, in order" record
/// that state is derived from.
model LedgerEntry {
  id            String          @id @default(cuid())
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("NGN")
  /// Free-form correlation id for grouping entries from the same economic
  /// event (e.g. a provider's payment reference) — not a foreign key.
  reference     String?
  userId        String?         @map("user_id")
  sellerId      String?         @map("seller_id")
  orderId       String?         @map("order_id")
  paymentId     String?         @map("payment_id")
  transactionId String?         @map("transaction_id")
  withdrawalId  String?         @map("withdrawal_id")
  /// Who/what caused this entry — null for system-driven entries (webhook
  /// confirmations, escrow release), set for admin-initiated ones (manual
  /// adjustment, withdrawal approval).
  actorId       String?         @map("actor_id")
  note          String?
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")

  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  seller SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  order  Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor  User?          @relation("LedgerEntryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([userId])
  @@index([sellerId])
  @@index([orderId])
  @@index([createdAt])
  @@map("ledger_entries")
}

model Review {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  authorId    String   @map("author_id")
  /// The specific purchase this review is for — unique, so "one review per
  /// purchased item" is a database guarantee, not just an application
  /// check. Also what proves the reviewer actually bought this (a
  /// "verified purchase" review), not just anyone with an account.
  orderItemId String   @unique @map("order_item_id")
  rating      Int
  comment     String?
  /// Soft-moderation by admin — hidden reviews are excluded from public
  /// queries but kept for record-keeping rather than hard-deleted.
  isHidden    Boolean  @default(false) @map("is_hidden")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Logistics
// ---------------------------------------------------------------------------

model Delivery {
  id                 String                  @id @default(cuid())
  orderId            String                  @unique @map("order_id")
  agentId            String?                 @map("agent_id")
  status             DeliveryStatus          @default(PENDING)
  method             DeliveryMethod          @default(MANUAL)
  address            Json
  pickupLocation     String?                 @map("pickup_location")
  deliveryFee        Decimal?                @map("delivery_fee") @db.Decimal(10, 2)
  /// Courier/logistics partner name — free text today (e.g. "GIG Logistics"),
  /// the natural place to switch to a partner-id FK once real logistics
  /// integrations exist.
  courier            String?
  trackingCode       String?                 @unique @map("tracking_code")
  estimatedAt        DateTime?               @map("estimated_at")
  deliveredAt        DateTime?               @map("delivered_at")
  /// The following four columns are the *final chosen* quote from
  /// `calculateDeliveryQuote`, persisted once at order time — every other
  /// quote (product page, cart) is computed on demand and never stored.
  distanceKm         Float?                  @map("distance_km")
  zoneLabel          String?                 @map("zone_label")
  estimatedMinutes   Int?                    @map("estimated_minutes")
  fulfillmentType    DeliveryFulfillmentType @default(STANDARD) @map("fulfillment_type")
  logisticsPartnerId String?                 @map("logistics_partner_id")
  /// Proof-of-delivery — captured by the rider at hand-off. `proofMethod`
  /// records which of the multiple supported confirmation methods was
  /// actually used; only the matching field(s) below are populated.
  proofMethod        ProofMethod?            @map("proof_method")
  proofPin           String?                 @map("proof_pin")
  proofPhotoUrl      String?                 @map("proof_photo_url")
  proofSignatureUrl  String?                 @map("proof_signature_url")
  proofNotes         String?                 @map("proof_notes")
  proofLatitude      Float?                  @map("proof_latitude")
  proofLongitude     Float?                  @map("proof_longitude")
  proofConfirmedAt   DateTime?               @map("proof_confirmed_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent            User?             @relation("AgentDeliveries", fields: [agentId], references: [id])
  logisticsPartner LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)
  events           DeliveryEvent[]

  @@index([agentId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryEvent {
  id         String         @id @default(cuid())
  deliveryId String         @map("delivery_id")
  status     DeliveryStatus
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("delivery_events")
}

// ---------------------------------------------------------------------------
// Smart Delivery Engine (Phase 4.5) — zone/city pricing, partner roster,
// global thresholds. Never hardcoded in application code; see
// services/logistics/delivery-engine.service.ts.
// ---------------------------------------------------------------------------

/// Global distance-band definitions shared across every city — the bands
/// themselves ("0-2km", "2-5km", ...) rarely change; per-city price on top
/// of a given band lives in `CityDeliveryPricing`. `maxKm: null` means
/// unbounded (the top band, e.g. "20km+").
model DeliveryZone {
  id          String   @id @default(cuid())
  label       String   @unique
  minKm       Float    @map("min_km")
  maxKm       Float?   @map("max_km")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy   User?                 @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  cityPricing CityDeliveryPricing[]

  @@index([isActive])
  @@map("delivery_zones")
}

/// Per-city price for a zone. `city: null` is the platform-default
/// fallback row for any city without an explicit override — the same
/// null-means-default convention as `CommissionRule.categoryId`. One row
/// per (city, zone) is enforced by application code, not a DB constraint —
/// Postgres unique constraints don't treat multiple NULLs as duplicates,
/// so a compound unique on a nullable `city` column can't guarantee this
/// (same reasoning as `SubscriptionPlan.isDefault`/`IntegrationSetting.isPrimary`).
model CityDeliveryPricing {
  id          String   @id @default(cuid())
  city        String?
  zoneId      String   @map("zone_id")
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("NGN")
  isActive    Boolean  @default(true) @map("is_active")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  updatedBy User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([city, zoneId])
  @@map("city_delivery_pricing")
}

/// Super Admin-managed roster of external courier/delivery partners.
/// Data-model only — no live API integration yet (`pricingModel` is a
/// free-text/JSON placeholder). The natural place `Delivery.courier`
/// graduates to once a real partner integration exists; kept alongside it
/// for ad-hoc manual entries not in this roster.
model LogisticsPartner {
  id               String   @id @default(cuid())
  name             String   @unique
  logoUrl          String?  @map("logo_url")
  coverageCities   String[] @map("coverage_cities")
  pricingModel     String?  @map("pricing_model")
  estimatedMinutes Int?     @map("estimated_minutes")
  isActive         Boolean  @default(true) @map("is_active")
  contactPhone     String?  @map("contact_phone")
  contactEmail     String?  @map("contact_email")
  notes            String?
  updatedById      String?  @map("updated_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  updatedBy  User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@index([isActive])
  @@map("logistics_partners")
}

/// Singleton row (fixed id "singleton") — global delivery thresholds,
/// same pattern as `SystemSettings`.
model DeliveryRule {
  id                     String   @id @default("singleton")
  pickupRadiusKm         Float    @default(3) @map("pickup_radius_km")
  sameDayRadiusKm        Float    @default(8) @map("same_day_radius_km")
  sameDayCutoffHour      Int      @default(14) @map("same_day_cutoff_hour")
  maxDeliveryDistanceKm  Float    @default(50) @map("max_delivery_distance_km")
  expressAvailable       Boolean  @default(true) @map("express_available")
  expressSurcharge       Decimal  @default(0) @map("express_surcharge") @db.Decimal(10, 2)
  emergencyDisableAll    Boolean  @default(false) @map("emergency_disable_all")
  emergencyDisableReason String?  @map("emergency_disable_reason")
  updatedById            String?  @map("updated_by_id")
  updatedAt              DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("delivery_rules")
}

/// Dated overrides — a full holiday calendar can't live on the
/// `DeliveryRule` singleton since dates are inherently multi-row.
model DeliveryHoliday {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  label           String
  disablesSameDay Boolean  @default(true) @map("disables_same_day")
  disablesAll     Boolean  @default(false) @map("disables_all")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([date])
  @@map("delivery_holidays")
}

/// In-house delivery rider — a 1:1 profile extension of a `User` with
/// `role: RIDER`, the same shape `SellerProfile` uses for `role: SELLER`.
/// Deliveries are assigned by writing a rider's `User.id` onto the
/// already-existing (and previously unused) `Delivery.agentId` — no change
/// to that FK was needed. Earnings reuse the existing role-agnostic
/// `Wallet` model (already keyed by `userId`, not by seller).
model RiderProfile {
  id                    String                  @id @default(cuid())
  userId                String                  @unique @map("user_id")
  vehicleType           String?                 @map("vehicle_type")
  vehiclePlateNumber    String?                 @map("vehicle_plate_number")
  status                RiderStatus             @default(OFFLINE)
  latitude              Float?
  longitude             Float?
  locationUpdatedAt     DateTime?               @map("location_updated_at")
  ratingAverage         Float                   @default(0) @map("rating_average")
  ratingCount           Int                     @default(0) @map("rating_count")
  totalDeliveries       Int                     @default(0) @map("total_deliveries")
  isActive              Boolean                 @default(true) @map("is_active")
  /// Self-signup onboarding progress — mirrors SellerProfile.onboardingStep
  /// (1 = registered, 2 = personal confirmed, 3 = vehicle info submitted,
  /// 4 = verification submitted/completed). Admin-created riders
  /// (createRiderAccount) skip straight to step 4, already completed.
  onboardingStep        Int                     @default(1) @map("onboarding_step")
  onboardingCompletedAt DateTime?               @map("onboarding_completed_at")
  /// Dispatch eligibility gate — only VERIFIED riders can go AVAILABLE or
  /// be assigned a delivery, regardless of `isActive`. Admin-created riders
  /// default to VERIFIED (the admin already vetted them out-of-band);
  /// self-signups default to PENDING and go through RiderVerification.
  verificationStatus    RiderVerificationStatus @default(PENDING) @map("verification_status")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification RiderVerification?
  withdrawals  RiderWithdrawal[]

  @@index([status])
  @@map("rider_profiles")
}

/// Mirrors SellerVerification exactly, one document set fixed at three
/// fields — a rider's ID, driving license (only required for
/// motorised vehicles), and a photo of the vehicle itself.
model RiderVerification {
  id                 String                  @id @default(cuid())
  riderProfileId     String                  @unique @map("rider_profile_id")
  idDocumentUrl      String?                 @map("id_document_url")
  licenseDocumentUrl String?                 @map("license_document_url")
  vehiclePhotoUrl    String?                 @map("vehicle_photo_url")
  status             RiderVerificationStatus @default(PENDING)
  reviewedById       String?                 @map("reviewed_by_id")
  reviewNotes        String?                 @map("review_notes")
  submittedAt        DateTime                @default(now()) @map("submitted_at")
  reviewedAt         DateTime?               @map("reviewed_at")

  riderProfile RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("rider_verifications")
}

// ---------------------------------------------------------------------------
// Messaging (foundation — buyer/seller only, no groups, no attachments yet)
// ---------------------------------------------------------------------------

enum ConversationType {
  PRODUCT_INQUIRY
  ORDER_SUPPORT
  DISPUTE_DISCUSSION
}

/// One conversation per (buyer, seller, type, product/order/dispute) rather
/// than a single lifetime thread per buyer-seller pair — asking about two
/// different products, or getting order support, are separate threads with
/// their own context. Matching on create is done at the application layer
/// (`getOrCreateConversation`), not a DB unique constraint, since Postgres
/// treats NULL productId/orderId/disputeId columns as always-distinct,
/// which would defeat "reuse the general inquiry thread" matching.
model Conversation {
  id                 String           @id @default(cuid())
  buyerId            String           @map("buyer_id")
  sellerProfileId    String           @map("seller_profile_id")
  type               ConversationType @default(PRODUCT_INQUIRY)
  productId          String?          @map("product_id")
  orderId            String?          @map("order_id")
  disputeId          String?          @map("dispute_id")
  isArchivedByBuyer  Boolean          @default(false) @map("is_archived_by_buyer")
  isArchivedBySeller Boolean          @default(false) @map("is_archived_by_seller")
  isReported         Boolean          @default(false) @map("is_reported")
  reportedAt         DateTime?        @map("reported_at")
  reportReason       String?          @map("report_reason")
  lastMessageAt      DateTime         @default(now()) @map("last_message_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  buyer         User          @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dispute       Dispute?      @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  messages      Message[]
  offers        Offer[]
  flags         MessageFlag[]

  @@index([buyerId, sellerProfileId, type])
  @@index([sellerProfileId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  body           String
  imageUrl       String?   @map("image_url")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  flag         MessageFlag?

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageFlagType {
  PHONE_NUMBER
  EMAIL_ADDRESS
  WHATSAPP
  EXTERNAL_PAYMENT
  SOCIAL_HANDLE
  BANK_ACCOUNT
}

/// One row per message that matched a contact-sharing/off-platform pattern
/// — the source of truth for the Phase-5 warning flow and Phase-11 admin
/// trust dashboard. `matchedSnippet` is a short, already-redacted excerpt
/// (never the full contact detail) kept only so a reviewer can see *why*
/// it was flagged without the flag table itself becoming a second place
/// the actual phone/email leaks to.
model MessageFlag {
  id             String          @id @default(cuid())
  messageId      String          @unique @map("message_id")
  conversationId String          @map("conversation_id")
  userId         String          @map("user_id")
  flagType       MessageFlagType @map("flag_type")
  matchedSnippet String          @map("matched_snippet")
  createdAt      DateTime        @default(now()) @map("created_at")

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId])
  @@map("message_flags")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  CANCELLED
}

/// A price negotiation scoped to one product inquiry conversation. A
/// counter-offer is a new row linked back via `previousOfferId` (the old
/// row moves to COUNTERED) rather than mutating amount in place, so the
/// full back-and-forth stays visible. Accepting creates a real Order at
/// exactly this amount — `order.service.ts#createOrder` re-reads the
/// ACCEPTED offer server-side rather than trusting a client-supplied price,
/// so payment still flows through the existing escrow pipeline unchanged.
model Offer {
  id              String      @id @default(cuid())
  conversationId  String      @map("conversation_id")
  productId       String      @map("product_id")
  buyerId         String      @map("buyer_id")
  sellerId        String      @map("seller_id")
  amount          Decimal     @db.Decimal(10, 2)
  status          OfferStatus @default(PENDING)
  previousOfferId String?     @unique @map("previous_offer_id")
  orderId         String?     @unique @map("order_id")
  expiresAt       DateTime?   @map("expires_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  conversation  Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer         User          @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  previousOffer Offer?        @relation("OfferCounters", fields: [previousOfferId], references: [id], onDelete: SetNull)
  counteredBy   Offer?        @relation("OfferCounters")
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([sellerId, status])
  @@index([buyerId])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// One row per known event key ("order_paid", "seller_approved", etc.) —
/// the Super Admin-editable copy behind every templated email the
/// notification engine sends. `bodyHtml` and `subject` may contain
/// `{{variable}}` placeholders (see services/notifications/template.ts);
/// unknown placeholders are left as-is rather than throwing, so a typo'd
/// variable degrades to visible-but-harmless instead of a broken send.
model EmailTemplate {
  key         String   @id
  label       String
  subject     String
  bodyHtml    String   @map("body_html")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("email_templates")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Every attempted send through any channel — the audit trail
/// `services/notifications/notify.service.ts` needs to prove an event
/// actually reached (or failed to reach) someone, and the basis for
/// future retry logic. Deliberately separate from `Notification` (the
/// in-app inbox row): one event can produce a `Notification` with zero,
/// one, or several `NotificationDelivery` rows (e.g. email today, SMS
/// later) — they track different things and fail independently.
model NotificationDelivery {
  id            String                     @id @default(cuid())
  userId        String?                    @map("user_id")
  channel       NotificationChannel
  status        NotificationDeliveryStatus @default(PENDING)
  /// Integration provider that handled this attempt (e.g. "resend"), null
  /// until a provider is actually resolved for the send.
  provider      String?
  templateKey   String?                    @map("template_key")
  /// Email address or phone number this attempt targeted — kept even if
  /// the user record is later deleted, since it's the delivery record.
  recipient     String
  attemptCount  Int                        @default(1) @map("attempt_count")
  failureReason String?                    @map("failure_reason")
  sentAt        DateTime?                  @map("sent_at")
  createdAt     DateTime                   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("notification_deliveries")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------

model Dispute {
  id           String        @id @default(cuid())
  orderId      String        @map("order_id")
  buyerId      String        @map("buyer_id")
  sellerId     String        @map("seller_id")
  type         DisputeType
  description  String
  evidenceUrls String[]      @map("evidence_urls")
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedById String?       @map("resolved_by_id")
  resolvedAt   DateTime?     @map("resolved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer         User           @relation("BuyerDisputes", fields: [buyerId], references: [id])
  seller        SellerProfile  @relation(fields: [sellerId], references: [id])
  resolvedBy    User?          @relation("ResolvedDisputes", fields: [resolvedById], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([status])
  @@index([sellerId])
  @@index([orderId])
  @@map("disputes")
}

// ---------------------------------------------------------------------------
// Customer Experience Center — returns (distinct from Disputes) and
// general support tickets
// ---------------------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  COMPLETED
}

enum ReturnOutcome {
  FULL_REFUND
  PARTIAL_REFUND
  REPLACEMENT
  REFUND_WITHOUT_RETURN
  REJECTED
}

/// Item-level, buyer-initiated, no-fault-implied — kept distinct from
/// `Dispute` (order-level, fault/blame, drives escrow release-or-refund).
/// A buyer wanting to send something back for any reason files a Return;
/// a buyer alleging the seller did something wrong files a Dispute.
model ReturnRequest {
  id              String         @id @default(cuid())
  orderItemId     String         @unique @map("order_item_id")
  buyerId         String         @map("buyer_id")
  sellerId        String         @map("seller_id")
  reason          String
  evidenceUrls    String[]       @map("evidence_urls")
  status          ReturnStatus   @default(REQUESTED)
  outcome         ReturnOutcome?
  refundAmount    Decimal?       @map("refund_amount") @db.Decimal(10, 2)
  resolvedById    String?        @map("resolved_by_id")
  resolvedAt      DateTime?      @map("resolved_at")
  resolutionNotes String?        @map("resolution_notes")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  orderItem  OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyer      User          @relation("BuyerReturns", fields: [buyerId], references: [id])
  seller     SellerProfile @relation(fields: [sellerId], references: [id])
  resolvedBy User?         @relation("ResolvedReturns", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sellerId])
  @@map("return_requests")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  NORMAL
  HIGH
  URGENT
}

/// General buyer help requests that aren't order-specific (unlike
/// `Dispute`). "Escalation" is just `priority: URGENT` + `escalatedAt` set,
/// not a separate entity.
model SupportTicket {
  id           String                @id @default(cuid())
  userId       String                @map("user_id")
  subject      String
  category     String?
  description  String
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(NORMAL)
  escalatedAt  DateTime?             @map("escalated_at")
  assignedToId String?               @map("assigned_to_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  user       User                   @relation("SupportTicketsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?                  @relation("SupportTicketsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportTicketMessage[]

  @@index([status])
  @@index([assignedToId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  senderId  String   @map("sender_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

// ---------------------------------------------------------------------------
// Permission Engine — Founder creates unlimited custom staff roles, each a
// named bundle of permissions. Layered underneath the existing
// `getEffectivePermissions()` (lib/auth/permissions.ts) — every
// `requireRole`/`requirePermission` call site is unchanged; only what
// backs "does this ADMIN have permission X" grows to also check the
// assigned StaffRole. SUPER_ADMIN's implicit wildcard is untouched by any
// of this — "Founder" is just that role's display label.
// ---------------------------------------------------------------------------

/// A named, reusable bundle of permissions assignable to ADMIN-role users.
/// `isSystemDefined` marks the ~18 seeded defaults (Finance Manager,
/// Compliance Officer, etc.) — still editable, just not silently
/// deletable by an accidental cleanup pass.
model StaffRole {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  isSystemDefined Boolean  @default(false) @map("is_system_defined")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy   User?                 @relation("StaffRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  permissions StaffRolePermission[]
  users       User[]                @relation("StaffAssignment")

  @@map("staff_roles")
}

model StaffRolePermission {
  id         String @id @default(cuid())
  roleId     String @map("role_id")
  permission String

  role StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("staff_role_permissions")
}

/// Singleton row (fixed id "singleton") — global marketplace switches.
model SystemSettings {
  id                          String            @id @default("singleton")
  platformName                String            @default("Selecta") @map("platform_name")
  maintenanceMode             Boolean           @default(false) @map("maintenance_mode")
  maintenanceMessage          String?           @map("maintenance_message")
  allowNewSellers             Boolean           @default(true) @map("allow_new_sellers")
  allowNewBuyers              Boolean           @default(true) @map("allow_new_buyers")
  requireProductApproval      Boolean           @default(true) @map("require_product_approval")
  requireSellerVerification   Boolean           @default(true) @map("require_seller_verification")
  marketplaceStatus           MarketplaceStatus @default(OPEN) @map("marketplace_status")
  /// "From" identity for every templated email the notification engine
  /// sends — e.g. "Selecta" <notifications@selectapick.store>. Blank
  /// sender email falls back to a hardcoded default at send time rather
  /// than failing the send outright.
  notificationSenderName      String            @default("Selecta") @map("notification_sender_name")
  notificationSenderEmail     String?           @map("notification_sender_email")
  /// Cash price per day for a product boost campaign when a seller has no
  /// (or insufficient) subscription boost credits to cover it — Super
  /// Admin-configurable, never hardcoded in application code.
  boostPricePerDay            Decimal           @default(500) @map("boost_price_per_day") @db.Decimal(10, 2)
  /// Days an escrowed Transaction is held before it's eligible for
  /// automatic weekly settlement (see the weekly-settlement cron).
  escrowHoldDays              Int               @default(3) @map("escrow_hold_days")
  minWithdrawalAmount         Decimal           @default(1000) @map("min_withdrawal_amount") @db.Decimal(10, 2)
  maxWithdrawalAmount         Decimal?          @map("max_withdrawal_amount") @db.Decimal(10, 2)
  autoWeeklySettlement        Boolean           @default(false) @map("auto_weekly_settlement")
  /// Extra days beyond escrowHoldDays before an auto-settled amount is
  /// actually paid out — a fraud/chargeback buffer.
  settlementCoolingPeriodDays Int               @default(0) @map("settlement_cooling_period_days")
  /// Percentage of a delivery's `deliveryFee` credited to the assigned
  /// rider's wallet on confirmed delivery — the rest stays platform
  /// revenue (already booked in full at payment time via
  /// DELIVERY_FEE_REVENUE; see RIDER_PAYOUT_EARNED's doc comment).
  riderPayoutPercentage       Int               @default(70) @map("rider_payout_percentage")
  updatedById                 String?           @map("updated_by_id")
  updatedAt                   DateTime          @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

/// One row per (category, provider) — e.g. (PAYMENT, "paystack"),
/// (STORAGE, "cloudflare-r2"). Actual credentials live in `IntegrationSecret`,
/// never here — this row only holds non-secret config + enable state.
model IntegrationSetting {
  id          String              @id @default(cuid())
  category    IntegrationCategory
  provider    String
  isEnabled   Boolean             @default(false) @map("is_enabled")
  isPrimary   Boolean             @default(false) @map("is_primary")
  config      Json?
  updatedById String?             @map("updated_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  updatedBy User?               @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  secrets   IntegrationSecret[]

  @@unique([category, provider])
  @@map("integration_settings")
}

/// Encrypted-at-rest credential values. `encryptedValue` is AES-256-GCM
/// ciphertext (iv+authTag+ciphertext packed, base64) — see
/// lib/security/encryption.ts. Only `lastFourDisplay` (plaintext) is ever
/// shown in the UI, masked like `********************x7d9`.
model IntegrationSecret {
  id                   String   @id @default(cuid())
  integrationSettingId String   @map("integration_setting_id")
  key                  String
  encryptedValue       String   @map("encrypted_value")
  lastFourDisplay      String   @map("last_four_display")
  rotatedAt            DateTime @default(now()) @map("rotated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  integrationSetting IntegrationSetting @relation(fields: [integrationSettingId], references: [id], onDelete: Cascade)

  @@unique([integrationSettingId, key])
  @@map("integration_secrets")
}

/// `categoryId = null` is the platform default rate. A category-specific
/// row overrides the default for that category. No commission is ever
/// hardcoded in application code — see services/platform/commission.service.ts.
model CommissionRule {
  id            String    @id @default(cuid())
  categoryId    String?   @map("category_id")
  label         String
  percentage    Float
  isPromotional Boolean   @default(false) @map("is_promotional")
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([isActive])
  @@map("commission_rules")
}

model FeatureFlag {
  key         String   @id
  label       String
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// AI Marketplace Assistant
// ---------------------------------------------------------------------------

/// Singleton row (fixed id "singleton") — the AI Marketplace Assistant's own
/// tunables. Provider/model are deliberately NOT here: they're global,
/// shared with AI Product Writer, and live on IntegrationSetting (category
/// "AI") — this table only holds what's genuinely per-feature.
model AiAssistantSettings {
  id                      String   @id @default("singleton")
  isEnabled               Boolean  @default(false) @map("is_enabled")
  isFloatingButtonEnabled Boolean  @default(true) @map("is_floating_button_enabled")
  welcomeMessage          String   @default("👋 Welcome to Selecta Assistant") @map("welcome_message")
  placeholderText         String   @default("Ask anything about products...") @map("placeholder_text")
  /// JSON string[] of quick-action prompts shown on the welcome screen.
  suggestedPrompts        Json     @map("suggested_prompts")
  /// Messages per conversation before the assistant tells the buyer to
  /// start a new one — bounds both cost and prompt-context growth.
  maxConversationLength   Int      @default(30) @map("max_conversation_length")
  systemPrompt            String   @map("system_prompt")
  temperature             Float    @default(0.7)
  streamingEnabled        Boolean  @default(true) @map("streaming_enabled")
  updatedById             String?  @map("updated_by_id")
  updatedAt               DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("ai_assistant_settings")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// One row per authenticated buyer's assistant conversation. Guest
/// conversations are never persisted here — chat history for guests lives
/// only in browser localStorage — so userId is a required FK, not nullable.
model AiConversation {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  /// Auto-derived short label (first ~40 chars of the first user message)
  /// for a future conversation-list UI.
  title      String?
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiConversationMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id               String        @id @default(cuid())
  conversationId   String        @map("conversation_id")
  role             AiMessageRole
  content          String
  promptTokens     Int?          @map("prompt_tokens")
  completionTokens Int?          @map("completion_tokens")
  createdAt        DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_conversation_messages")
}

// ---------------------------------------------------------------------------
// Monetization — seller subscriptions, product boosts, growth partner
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BoostGoal {
  VIEWS
  SAVES
  SALES
}

enum BoostStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MonetizationPurpose {
  SUBSCRIPTION
  BOOST
}

enum MonetizationPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GrowthApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

/// Super Admin-controlled membership tier. Never hardcoded in application
/// code — every price/limit/benefit a plan grants lives on this row, read
/// at the point of enforcement (see services/monetization/subscription.service.ts).
model SubscriptionPlan {
  id                   String   @id @default(cuid())
  name                 String   @unique
  slug                 String   @unique
  monthlyPrice         Decimal  @default(0) @map("monthly_price") @db.Decimal(10, 2)
  durationDays         Int      @default(30) @map("duration_days")
  /// Null = unlimited active listings.
  maxProducts          Int?     @map("max_products")
  boostCreditsPerCycle Int      @default(0) @map("boost_credits_per_cycle")
  hasAnalyticsAccess   Boolean  @default(false) @map("has_analytics_access")
  hasFeaturedStore     Boolean  @default(false) @map("has_featured_store")
  hasPrioritySupport   Boolean  @default(false) @map("has_priority_support")
  /// The plan applied to a seller with no subscription history at all.
  /// Enforced to be unique-among-active by application code (like
  /// IntegrationSetting.isPrimary), not a DB constraint.
  isDefault            Boolean  @default(false) @map("is_default")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdById          String?  @map("created_by_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  createdBy     User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  subscriptions SellerSubscription[]
  features      PlanFeature[]

  @@index([isActive])
  @@map("subscription_plans")
}

/// Feature flags scoped to a specific plan, editable from the admin plans UI
/// with no code deploy — `featureKey` is a free string matching a
/// `FeatureKey` value in code (see services/monetization/entitlement.service.ts).
/// This is deliberately separate from the fixed boolean columns above
/// (maxProducts, hasAnalyticsAccess, etc.): those are the small, stable set
/// of "core" limits with dedicated enforcement already wired elsewhere;
/// this table is for anything added later (AI features first) without a
/// schema migration each time.
model PlanFeature {
  id           String   @id @default(cuid())
  planId       String   @map("plan_id")
  featureKey   String   @map("feature_key")
  enabled      Boolean  @default(false)
  /// Null = no cap (still gated by `enabled`, just unlimited uses per cycle).
  monthlyLimit Int?     @map("monthly_limit")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

/// Real per-seller, per-feature usage counting for anything with a
/// monthly cap (AI features today). Cycle = calendar month, not the
/// seller's individual subscription renewal date — simpler, and matches
/// "N actions/month" exactly. One row per (seller, feature, month);
/// `count` increments only on a successful use, never on a failed call.
model AiFeatureUsage {
  id               String   @id @default(cuid())
  sellerId         String   @map("seller_id")
  featureKey       String   @map("feature_key")
  cycleStart       DateTime @map("cycle_start")
  count            Int      @default(0)
  /// Which provider/model actually served the most recent call this cycle
  /// — informational (reflects the last call, not cumulative), so an
  /// admin can see what's actually being billed without a separate
  /// tracking table. Null for cycles predating this column (existing
  /// rows), never backfilled.
  provider         String?
  model            String?
  /// Token counts ARE cumulative across the cycle — same accumulation
  /// pattern as `count`, so a monthly token/cost view is one `SUM()`
  /// away without a new table.
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, featureKey, cycleStart])
  @@map("ai_feature_usages")
}

/// One row per subscription period a seller has ever had — history is kept
/// (never overwritten), so "current" means the single row with
/// status ACTIVE (enforced by application code, not a DB constraint, since
/// a seller legitimately accumulates many EXPIRED/CANCELLED rows over time).
model SellerSubscription {
  id                    String             @id @default(cuid())
  sellerId              String             @map("seller_id")
  planId                String             @map("plan_id")
  status                SubscriptionStatus @default(PENDING)
  startedAt             DateTime?          @map("started_at")
  expiresAt             DateTime?          @map("expires_at")
  boostCreditsRemaining Int                @default(0) @map("boost_credits_remaining")
  cancelledAt           DateTime?          @map("cancelled_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  seller   SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments MonetizationPayment[]

  @@index([sellerId, status])
  @@index([status, expiresAt])
  @@map("seller_subscriptions")
}

/// A seller's paid visibility campaign for one product. Performance
/// (impressions/views/saves/orders) is deliberately NOT stored here — it's
/// derived on read from the existing ProductEvent stream and OrderItem
/// table, scoped to [startDate, endDate], so there's exactly one source of
/// truth for view/save counts instead of a second counter that could drift.
model BoostCampaign {
  id           String      @id @default(cuid())
  sellerId     String      @map("seller_id")
  productId    String      @map("product_id")
  goal         BoostGoal
  durationDays Int         @map("duration_days")
  creditsCost  Int         @map("credits_cost")
  status       BoostStatus @default(PENDING_PAYMENT)
  startDate    DateTime?   @map("start_date")
  endDate      DateTime?   @map("end_date")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  seller   SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product  Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  payments MonetizationPayment[]

  @@index([sellerId])
  @@index([productId, status])
  @@index([status, endDate])
  @@map("boost_campaigns")
}

/// Payment record for subscription/boost charges — deliberately separate
/// from `Payment` (which is 1:1 with an Order and drives escrow/commission
/// splitting). A subscription or boost charge is 100% platform revenue with
/// no seller split, so it doesn't belong on that model. Reuses the same
/// provider integration layer and the same append-only ledger underneath.
model MonetizationPayment {
  id                String                    @id @default(cuid())
  sellerId          String                    @map("seller_id")
  purpose           MonetizationPurpose
  subscriptionId    String?                   @map("subscription_id")
  boostCampaignId   String?                   @map("boost_campaign_id")
  amount            Decimal                   @db.Decimal(10, 2)
  currency          String                    @default("NGN")
  provider          String
  providerReference String?                   @unique @map("provider_reference")
  status            MonetizationPaymentStatus @default(PENDING)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  seller        SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  subscription  SellerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  boostCampaign BoostCampaign?      @relation(fields: [boostCampaignId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([status])
  @@map("monetization_payments")
}

/// Phase-10 placeholder for the future "Selecta Growth Partner" managed
/// service — intentionally minimal (application intake only, no delivery
/// workflow yet).
model GrowthPartnerApplication {
  id                String                  @id @default(cuid())
  sellerId          String                  @map("seller_id")
  status            GrowthApplicationStatus @default(PENDING)
  message           String?
  assignedManagerId String?                 @map("assigned_manager_id")
  notes             String?
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  assignedManager User?         @relation(fields: [assignedManagerId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([status])
  @@map("growth_partner_applications")
}

// ---------------------------------------------------------------------------
// Security
// ---------------------------------------------------------------------------

/// Persisted fixed-window rate-limit counters (login attempts, messages
/// sent, checkout attempts, etc.) — replaces an in-process Map that gave no
/// real protection on serverless, where each invocation can land on a
/// different instance with its own empty memory. `key` is a caller-chosen
/// string like "login:user@example.com:203.0.113.1"; the row is reused
/// (not reset to a new row) once its window has passed, so this table
/// self-bounds in size rather than growing forever.
model RateLimitEntry {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_entries")
}
